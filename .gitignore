backups/
*.dump
*.sql
!apps/backend/prisma/migrations/**/*.sql
*.backup
*.sqlite
*.sqlite3
*.db

# Archivos de Excel, CSV y volcados de datos
*.xlsx
*.xls
*.csv
*_parsed*.json
_parsed*.json
out.txt
stash_diff.txt

