!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ──────────────────────────────────────────────
#  Sistema operativo
# ──────────────────────────────────────────────
.DS_Store
Thumbs.db

# Archivos temporales de Office (Excel/Word abiertos)
~$*

# ──────────────────────────────────────────────
#  Artefactos de trabajo locales (NO van al repo)
# ──────────────────────────────────────────────
