# ──────────────────────────────────────────────
#  Dependencias
# ──────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.pnpm-store/

# ──────────────────────────────────────────────
#  Salidas de build
# ──────────────────────────────────────────────
dist/
dist-ssr/
build/
out/
*.tsbuildinfo

# Vite (frontend)
apps/frontend/dist/
.vite/

# NestJS (backend)
apps/backend/dist/

# Turborepo
.turbo/

# ──────────────────────────────────────────────
#  Prisma — cliente generado (se regenera con `prisma generate`)
# ──────────────────────────────────────────────
apps/backend/generated/

# ──────────────────────────────────────────────
#  Variables de entorno  —  NUNCA commitear secretos
#  Ignora .env, .env.test, .env.local, etc. pero deja los .example
# ──────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example

# ──────────────────────────────────────────────
#  Logs
# ──────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ──────────────────────────────────────────────
#  Tests / cobertura
# ──────────────────────────────────────────────
coverage/
.nyc_output/

# ──────────────────────────────────────────────
#  Editores / IDEs
# ──────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ──────────────────────────────────────────────
#  Sistema operativo
# ──────────────────────────────────────────────
.DS_Store
Thumbs.db

# Archivos temporales de Office (Excel/Word abiertos)
~$*

# ──────────────────────────────────────────────
#  Artefactos de trabajo locales (NO van al repo)
# ──────────────────────────────────────────────
# Scripts y data temporal del parser de migración de clientes
/_*

# Notas de revisión de sectores y barrios (working notes)
/REVISION_*.md
/BARRIOS_MAESTRO.md

# Dumps y backups de base de datos
/backup_*.sql
*.local.sql
