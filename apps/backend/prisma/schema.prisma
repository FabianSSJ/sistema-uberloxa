generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "commonjs"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id                Int        @id @default(autoincrement())
  nombre            String
  username          String     @unique
  passwordHash      String     @map("password_hash")
  activo            Boolean    @default(true)
  createdAt         DateTime   @default(now()) @map("created_at")
  modulosPermitidos String[]   @default([]) @map("modulos_permitidos")
  rol               RolUsuario @default(CHARLIE)
  color             String?
  carrerasCreadas   Carrera[]  @relation("CarrerasCreadas")

  @@map("usuarios")
}

model Sector {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique
  descripcion String?
  clientes    Cliente[]

  @@map("sectores")
}

model Cliente {
  id             Int       @id @default(autoincrement())
  nombre         String
  telefono       String?
  telefonoAlt    String?   @map("telefono_alt")
  sectorId       Int?      @map("sector_id")
  direccion      String?
  descripcion    String?
  linkGoogleMaps String?   @map("link_google_maps")
  activo         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  codigo         Int?      @unique
  carreras       Carrera[]
  sector         Sector?   @relation(fields: [sectorId], references: [id])

  @@index([sectorId])
  @@index([telefono])
  @@map("clientes")
}

model Marca {
  id      Int      @id @default(autoincrement())
  nombre  String   @unique
  modelos Modelo[]

  @@map("marcas")
}

model Modelo {
  id       Int      @id @default(autoincrement())
  marcaId  Int      @map("marca_id")
  nombre   String
  tipo     String?
  marca    Marca    @relation(fields: [marcaId], references: [id])
  unidades Unidad[]

  @@index([marcaId])
  @@map("modelos")
}

model Unidad {
  id             Int          @id @default(autoincrement())
  placa          String       @unique
  modeloId       Int?         @map("modelo_id")
  choferNombre   String?      @map("chofer_nombre")
  choferTelefono String?      @map("chofer_telefono")
  color          String?
  anio           Int?
  createdAt      DateTime     @default(now()) @map("created_at")
  numeroUnidad   String?      @unique @map("numero_unidad")
  vehiculo       String?
  estado         EstadoUnidad @default(inactivo)
  colorIdentidad String?      @map("color_identidad")
  activadoEn     DateTime?    @map("activado_en")
  carreras       Carrera[]
  modelo         Modelo?      @relation(fields: [modeloId], references: [id])

  @@index([modeloId])
  @@map("unidades")
}

model Carrera {
  id           Int                      @id @default(autoincrement())
  clienteId    Int                      @map("cliente_id")
  unidadId     Int?                     @map("unidad_id")
  creadoPorId  Int?                     @map("creado_por")
  estado       EstadoCarrera            @default(pendiente)
  notas        String?
  createdAt    DateTime                 @default(now()) @map("created_at")
  fechaFin     DateTime?                @map("fecha_fin")
  numeroDiario Int?                     @map("numero_diario")
  cliente      Cliente                  @relation(fields: [clienteId], references: [id])
  creadoPor    Usuario?                 @relation("CarrerasCreadas", fields: [creadoPorId], references: [id])
  unidad       Unidad?                  @relation(fields: [unidadId], references: [id])
  historial    HistorialEstadoCarrera[]

  @@index([clienteId])
  @@index([unidadId])
  @@index([estado])
  @@index([createdAt])
  @@index([unidadId, createdAt])
  @@map("carreras")
}

model HistorialEstadoCarrera {
  id             Int            @id @default(autoincrement())
  carreraId      Int            @map("carrera_id")
  estadoAnterior EstadoCarrera? @map("estado_anterior")
  estadoNuevo    EstadoCarrera  @map("estado_nuevo")
  fechaHora      DateTime       @default(now()) @map("fecha_hora")
  carrera        Carrera        @relation(fields: [carreraId], references: [id])

  @@index([carreraId])
  @@index([fechaHora])
  @@map("historial_estados_carrera")
}

enum RolUsuario {
  SUPERADMIN
  ADMIN
  CHARLIE
}

enum EstadoUnidad {
  disponible
  ocupado
  inactivo
  descanso
}

enum EstadoCarrera {
  pendiente
  asignada
  completada
  cancelada
  perdida
}
